{
  "id": "iotop-test-review",
  "name": "iotop (テスト用レビュー確認)",
  "version": "0.1.0",
  "author": "test-contributor",
  "description": "admin.htmlのレビューフロー動作確認用のテストプラグインです(iotopでディスクI/Oを監視)。",
  "actions": [
    {
      "id": "snapshot",
      "label": "I/O状況を1回だけ取得",
      "cli": [
        "iotop",
        "-b",
        "-n",
        "1"
      ],
      "privileged": true
    },
    {
      "id": "version",
      "label": "バージョン確認",
      "cli": [
        "iotop",
        "--version"
      ],
      "privileged": false
    }
  ],
  "docs": "docs.md"
}
